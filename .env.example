# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Guild to sync slash commands to (fast sync; optional)
GUILD_ID=

# Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Owner user IDs (comma separated) allowed to run /admin commands
OWNER_IDS=

# Optional: target user to mimic / training channel (used by convenience scripts)
TARGET_USER_ID=
TRAINING_CHANNEL_ID=

# Logging level: DEBUG / INFO / WARNING
LOG_LEVEL=INFO